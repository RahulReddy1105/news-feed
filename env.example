# News API Configuration
NEWS_API_KEY=your_news_api_key_here

# OpenAI Configuration (optional - for advanced AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Flask Configuration
SECRET_KEY=your_secret_key_here
